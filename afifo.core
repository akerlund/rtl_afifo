CAPI=2:
name: "akerlund::afifo:1.0.0"
description: "Asynchronous FIFO with gray-code pointer synchronization"

filesets:
  rtl:
    files:
      - rtl/gray_to_bin.sv
      - rtl/afifo.sv
      - rtl/afifo_core.sv
    file_type: systemVerilogSource
    depend:
      - "akerlund::cdc_bit_sync:1.0.0"
      - "akerlund::memory_reg:1.0.0"
      - "akerlund::memory_ram:1.0.0"
      - "akerlund::fifo:1.0.0"

parameters:
  DATA_WIDTH_P:
    datatype: int
    default: 128
    paramtype: vlogparam
  ADDR_WIDTH_P:
    datatype: int
    default: 2
    paramtype: vlogparam

targets:
  default:
    filesets:
      - rtl

  rtl:
    flow: lint
    flow_options:
      tool: verilator
      verilator_options:
        - -Wall
        - --timing
        - --error-limit
        - "0"
        - -Werror-IMPLICIT
        - -Werror-BLKSEQ
        - -Werror-LATCH
        - -Werror-CASEINCOMPLETE
        - -Wno-UNUSEDSIGNAL
        - -Wno-PINCONNECTEMPTY
    filesets:
      - rtl
    parameters:
      - DATA_WIDTH_P
      - ADDR_WIDTH_P
    toplevel: afifo
