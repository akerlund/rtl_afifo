CAPI=2:
name: "akerlund::afifo_example:0"
description: "Asynchronous FIFO SystemVerilog/UVM testbench"

filesets:
  tb:
    files:
      # Compilation units
      - tb/fi_tb_pkg.sv
      - tc/fi_tc_pkg.sv
      - tb/fi_tb_top.sv
      # Include files (included by tb/tc packages)
      - tb/fi_env.sv: {is_include_file: true}
      - tb/fi_scoreboard.sv: {is_include_file: true}
      - tb/fi_virtual_sequencer.sv: {is_include_file: true}
      - tc/fi_base_test.sv: {is_include_file: true}
      - tc/tc_fi_basic.sv: {is_include_file: true}
      - tc/tc_fi_fast_to_slow.sv: {is_include_file: true}
      - tc/tc_fi_slow_to_fast.sv: {is_include_file: true}
    file_type: systemVerilogSource
    depend:
      - "akerlund::afifo:1.0.0"
      - "akerlund::vip_axi4s_agent:1.0.1"
      - "akerlund::vip_clk_rst_agent:0"
      - "akerlund::vip_report_server:0"

targets:
  default: &default
    flow: sim
    flow_options:
      tool: vcs
      # 3-stage mode analyses with vlogan first, which does not see -ntb_opts
      # here and so cannot resolve uvm_macros.svh or uvm_pkg. One vcs
      # invocation does analysis and elaboration together, which is also how
      # the sibling repos build their UVM testbenches.
      2_stage_flow: true
      vcs_options:
        - -ntb_opts
        - uvm-1.2
        # Queue for a licence instead of failing when the pool is busy.
        - -licqueue
      run_options:
        - +UVM_TESTNAME=tc_fi_basic
    filesets:
      - tb
    toplevel: fi_tb_top

  uvm:
    <<: *default
